<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:common="using:HappyChat.Desktop.Controls.Common"
    xmlns:forms="using:HappyChat.Desktop.Controls.Forms"
    xmlns:auth="using:HappyChat.Desktop.Controls.Auth"

    x:Class="HappyChat.Desktop.Views.Auth.CreateAccountView">

    <Grid>

        <!-- ================================================= -->
        <!-- Background                                      -->
        <!-- ================================================= -->

        <common:NexusBackground />


        <!-- ================================================= -->
        <!-- Nexus Logo                                       -->
        <!-- ================================================= -->

        <common:NexusLogo
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="48,35,0,0" />


        <!-- ================================================= -->
        <!-- Center Auth Card                                 -->
        <!-- ================================================= -->

        <auth:AuthCard
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <!-- ============================= -->
                <!-- Header                        -->
                <!-- ============================= -->

                <TextBlock
                    Text="Create your account"
                    Classes="AuthTitleStyle" />

                <TextBlock
                    Text="Join the next generation of communication"
                    Classes="AuthSubtitleStyle"
                    Margin="0,10,0,0" />


                <!-- ============================= -->
                <!-- Form                           -->
                <!-- ============================= -->

                <StackPanel
                    Margin="0,42,0,0"
                    Spacing="20">

                    <!-- Name -->

                    <forms:FormField
                        Label="NAME"
                        Placeholder="Jordan"
                        Text="{Binding Name, Mode=TwoWay}"
                        Error="{Binding NameError}" />


                    <!-- Last Name -->

                    <forms:FormField
                        Label="LAST NAME"
                        Placeholder="Blake"
                        Text="{Binding LastName, Mode=TwoWay}"
                        Error="{Binding LastNameError}" />

					<!-- Birthdate -->

					<forms:FormField
                        Label="BIRTHDATE"
                        Placeholder="1998-05-22"
                        Text="{Binding BirthDate, Mode=TwoWay}"
                        Error="{Binding BirthDateError}" />

					<!-- Phone Number -->

					<forms:FormField
                        Label="PHONE NUMBER"
                        Placeholder="+989129992222"
                        Text="{Binding PhoneNumber, Mode=TwoWay}"
                        Error="{Binding PhoneNumberError}" />

                </StackPanel>


                <!-- ============================= -->
                <!-- Create Account Button          -->
                <!-- ============================= -->

                <common:PrimaryButton
                    Margin="0,30,0,0"
                    Text="Create Account"
                    Command="{Binding CreateAccountCommand}" />


                <!-- ============================= -->
                <!-- General Error                  -->
                <!-- ============================= -->

                <TextBlock
                    Text="{Binding GeneralError}"
                    Foreground="{StaticResource ErrorBrush}"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="0,12,0,0"
                    IsVisible="{Binding GeneralError}" />


                <!-- ============================= -->
                <!-- Footer                         -->
                <!-- ============================= -->

                <auth:AuthFooter
                    Margin="0,32,0,0"
                    Text="Already have an account?"
                    LinkText="Sign In"
                    Command="{Binding NavigateToSignInCommand}" />

            </StackPanel>

        </auth:AuthCard>

    </Grid>

</UserControl>