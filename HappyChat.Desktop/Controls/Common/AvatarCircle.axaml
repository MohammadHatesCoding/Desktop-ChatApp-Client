<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="HappyChat.Desktop.Controls.Common.AvatarCircle"
    x:Name="Root">

	<Grid
        Width="{Binding Size, ElementName=Root}"
        Height="{Binding Size, ElementName=Root}">

		<Border
            CornerRadius="100"
            Background="{Binding AvatarBrush, ElementName=Root}">

			<TextBlock
                Text="{Binding Initials, ElementName=Root}"
                Foreground="White"
                FontWeight="Bold"
                FontSize="{Binding FontSize, ElementName=Root}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

		</Border>

		<Border
            Width="12"
            Height="12"
            CornerRadius="100"
            Background="#10B981"
            BorderBrush="#05070B"
            BorderThickness="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsVisible="{Binding IsOnline, ElementName=Root}" />

	</Grid>

</UserControl>