<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:HappyChat.Desktop.Controls.Common"
    x:Class="HappyChat.Desktop.Controls.Chat.ChatHeader"
    x:Name="Root">

	<Grid
        Height="80"
        ColumnDefinitions="Auto,*,Auto"
        Margin="24,0">

		<common:AvatarCircle
            Grid.Column="0"
            Size="44"
            Initials="{Binding Initials, ElementName=Root}"
            AvatarBrush="{Binding AvatarBrush, ElementName=Root}"
            IsOnline="{Binding IsOnline, ElementName=Root}" />

		<StackPanel
            Grid.Column="1"
            Margin="14,0,0,0"
            VerticalAlignment="Center">

			<TextBlock
                Text="{Binding Name, ElementName=Root}"
                Foreground="{DynamicResource TextBrush}"
                FontSize="16"
                FontWeight="SemiBold" />

			<TextBlock
                Text="{Binding StatusText, ElementName=Root}"
                Foreground="#34D399"
                FontSize="13"
                Margin="0,2,0,0" />

		</StackPanel>

		<StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="18"
            VerticalAlignment="Center">

			<Button
                Classes="NexusIconButton"
                Content="📞"
                Command="{Binding CallCommand, ElementName=Root}" />

			<Button
                Classes="NexusIconButton"
                Content="🎥"
                Command="{Binding VideoCallCommand, ElementName=Root}" />

			<Button
                Classes="NexusIconButton"
                Content="🔍"
                Command="{Binding SearchCommand, ElementName=Root}" />

			<Button
                Classes="NexusIconButton"
                Content="⋯"
                Command="{Binding MoreCommand, ElementName=Root}" />

		</StackPanel>

	</Grid>

</UserControl>