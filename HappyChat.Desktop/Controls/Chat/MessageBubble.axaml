<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="HappyChat.Desktop.Controls.Chat.MessageBubble">

    <Grid
        Margin="0,0,0,16">
    
        <StackPanel
            HorizontalAlignment="{Binding BubbleAlignment}"
            MaxWidth="620">


			<Border
				IsVisible="{Binding HasReply}"
				Background="#111827"
				Padding="8"
				Margin="0,0,0,6"
				CornerRadius="6"
				PointerPressed="ReplyPreview_OnPointerPressed">

				<StackPanel>

					<TextBlock
						Text="Replying to"
						FontSize="10"
						Foreground="{DynamicResource MutedTextBrush}"/>

					<TextBlock
						Text="{Binding RepliedMessagePreviewContent}"
						FontSize="11"
						TextWrapping="Wrap"/>

				</StackPanel>

			</Border>

			<Border
                Background="{Binding BubbleBackground}"
                CornerRadius="12"
                Padding="13,9">
            
            <TextBlock
                Text="{Binding Text}"
                Foreground="{Binding BubbleForeground}"
                FontSize="12"
                LineHeight="18"
                TextWrapping="Wrap"/>
            
            </Border>
            
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="{Binding BubbleAlignment}"
                Spacing="5"
                Margin="4,5,4,0">
            
                <TextBlock
                    Text="{Binding TimeText}"
                    FontSize="9"
                    Foreground="{Binding MetaForeground}"/>
                
                <TextBlock
                	Text="✓"
                	FontSize="9"
                	Foreground="{DynamicResource MutedTextBrush}"
                	IsVisible="{Binding ShowSentReceipt}"/>
                
                <TextBlock
                	Text="✓✓"
                	FontSize="9"
                	Foreground="{DynamicResource MutedTextBrush}"
                	IsVisible="{Binding ShowReadReceipt}"/>
            
            </StackPanel>
        
        </StackPanel>
    
    </Grid>

</UserControl>