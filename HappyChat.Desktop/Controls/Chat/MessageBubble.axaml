<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="HappyChat.Desktop.Controls.Chat.MessageBubble"
    x:Name="Root">

	<Grid Margin="0,4">

		<!-- Received (left) -->
		<StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="10"
            IsVisible="{Binding IsTheirs, ElementName=Root}">

			<Border
                Width="36"
                Height="36"
                CornerRadius="100"
                Background="{DynamicResource PrimaryBrush}"
                VerticalAlignment="Top">

				<TextBlock
                    Text="{Binding SenderInitials, ElementName=Root}"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

			</Border>

			<StackPanel MaxWidth="560">

				<Border
                    Background="{DynamicResource CardBrush}"
                    CornerRadius="16"
                    Padding="18,14">

					<TextBlock
                        Text="{Binding Content, ElementName=Root}"
                        Foreground="{DynamicResource TextBrush}"
                        FontSize="15"
                        TextWrapping="Wrap" />

				</Border>

				<StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="4,6,0,0">

					<Border
                        Background="{DynamicResource InputBrush}"
                        CornerRadius="100"
                        Padding="6,2"
                        IsVisible="{Binding HasReaction, ElementName=Root}">

						<TextBlock
                            Text="{Binding Reaction, ElementName=Root}"
                            FontSize="13" />

					</Border>

					<TextBlock
                        Text="{Binding TimeText, ElementName=Root}"
                        Foreground="{DynamicResource MutedTextBrush}"
                        FontSize="12" />

				</StackPanel>

			</StackPanel>

		</StackPanel>


		<!-- Sent (right) -->
		<StackPanel
            HorizontalAlignment="Right"
            IsVisible="{Binding IsMine, ElementName=Root}">

			<Border
                Background="{DynamicResource PrimaryBrush}"
                CornerRadius="16"
                Padding="18,14"
                MaxWidth="560"
                HorizontalAlignment="Right">

				<TextBlock
                    Text="{Binding Content, ElementName=Root}"
                    Foreground="White"
                    FontSize="15"
                    TextWrapping="Wrap" />

			</Border>

			<StackPanel
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                Margin="0,6,4,0">

				<Border
                    Background="{DynamicResource InputBrush}"
                    CornerRadius="100"
                    Padding="6,2"
                    IsVisible="{Binding HasReaction, ElementName=Root}">

					<TextBlock
                        Text="{Binding Reaction, ElementName=Root}"
                        FontSize="13" />

				</Border>

				<TextBlock
                    Text="{Binding TimeText, ElementName=Root}"
                    Foreground="{DynamicResource MutedTextBrush}"
                    FontSize="12" />

				<TextBlock
                    Text="✓"
                    Foreground="{Binding ReadTickBrush, ElementName=Root}"
                    FontSize="13" />

			</StackPanel>

		</StackPanel>

	</Grid>

</UserControl>