<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="HappyChat.Desktop.Controls.Forms.PasswordField"
    x:Name="Root">

	<StackPanel Spacing="8">

		<TextBlock
			Classes="NexusFieldLabel"
			Text="{Binding Label, ElementName=Root}" />

		<Grid>

			<TextBox
                x:Name="PasswordBox"
                Classes="NexusInput"
                Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
                Watermark="{Binding Placeholder, ElementName=Root}"
                PasswordChar="●"
                Padding="20,0,55,0" />

			<Button
                Width="48"
                Height="48"
                HorizontalAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding ToggleVisibilityCommand, ElementName=Root}">

				<TextBlock
                    Text="◉"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

			</Button>

		</Grid>

		<TextBlock
            Text="{Binding Error, ElementName=Root}"
            IsVisible="{Binding HasError, ElementName=Root}" />

	</StackPanel>

</UserControl>