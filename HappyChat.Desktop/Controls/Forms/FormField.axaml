<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="HappyChat.Desktop.Controls.Forms.FormField"
    x:Name="Root">

	<StackPanel Spacing="8">

		<!-- Label -->

		<TextBlock
            Classes="NexusFieldLabel"
            Text="{Binding Label, ElementName=Root}" />


		<!-- Input -->

		<TextBox
            Classes="NexusInput"
            Text="{Binding Text, ElementName=Root, Mode=TwoWay}"
            Watermark="{Binding Placeholder, ElementName=Root}"
            Classes.error="{Binding HasError, ElementName=Root}" />


		<!-- Error -->

		<TextBlock
            Classes="NexusFieldError"
            Text="{Binding Error, ElementName=Root}"
            IsVisible="{Binding HasError, ElementName=Root}" />

	</StackPanel>

</UserControl>