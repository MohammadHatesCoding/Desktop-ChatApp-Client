<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- ============================= -->
	<!-- TextBox -->
	<!-- ============================= -->	
	
	<Style Selector="TextBox.NexusInput">

		<Setter Property="Height" Value="56" />

		<Setter Property="Padding" Value="20,0" />

		<Setter Property="VerticalContentAlignment" Value="Center" />

		<Setter Property="Background" Value="{DynamicResource InputBrush}" />

		<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />

		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />

		<Setter Property="BorderThickness" Value="1" />

		<Setter Property="FontSize" Value="16" />

		<Setter Property="WatermarkForeground" Value="{DynamicResource SecondaryTextBrush}" />
		
		<Setter Property="CornerRadius" Value="18" />

	</Style>


	<!-- ================================================= -->
	<!-- TextBox Error State                               -->
	<!-- ================================================= -->

	<Style Selector="TextBox.NexusInput.error">

		<Setter Property="BorderBrush"
				Value="{DynamicResource ErrorBrush}" />

		<Setter Property="BorderThickness"
				Value="1" />

	</Style>


	<!-- Keep error border red while focused -->

	<Style Selector="TextBox.NexusInput.error:focus">

		<Setter Property="BorderBrush"
				Value="{DynamicResource ErrorBrush}" />

	</Style>


	<!-- ============================= -->
	<!-- FormField -->
	<!-- ============================= -->	
	
	<Style Selector="TextBlock.NexusFieldLabel">

		<Setter Property="FontSize" Value="13" />

		<Setter Property="FontWeight" Value="SemiBold" />

		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />

	</Style>

	<!-- ================================================= -->
	<!-- Field Error                                       -->
	<!-- ================================================= -->

	<Style Selector="TextBlock.NexusFieldError">

		<Setter Property="FontSize"
				Value="12" />

		<Setter Property="Foreground"
				Value="{DynamicResource ErrorBrush}" />

	</Style>


	<!-- ============================= -->
	<!-- OTP Input -->
	<!-- ============================= -->

	<Style Selector="TextBox.OtpInput">

		<Setter Property="Width"
				Value="54" />

		<Setter Property="Height"
				Value="60" />

		<Setter Property="Background"
				Value="#11151C" />

		<Setter Property="Foreground"
				Value="{DynamicResource TextBrush}" />

		<Setter Property="BorderBrush"
				Value="#2A3445" />

		<Setter Property="BorderThickness"
				Value="1" />

		<Setter Property="CornerRadius"
				Value="16" />

		<Setter Property="FontSize"
				Value="22" />

		<Setter Property="FontWeight"
				Value="SemiBold" />

		<Setter Property="HorizontalContentAlignment"
				Value="Center" />

		<Setter Property="VerticalContentAlignment"
				Value="Center" />

		<Setter Property="Padding"
				Value="0" />

	</Style>


	<!-- ============================= -->
	<!-- OTP Focus -->
	<!-- ============================= -->

	<Style Selector="TextBox.OtpInput:focus">

		<Setter Property="BorderBrush"
				Value="{DynamicResource PrimaryBrush}" />

		<Setter Property="BorderThickness"
				Value="1" />

	</Style>
	
	<!-- ============================= -->
	<!-- Primary Button -->
	<!-- ============================= -->

	<Style Selector="Button.NexusPrimaryButton">
		
		<Setter Property="Height" Value="60" />
		
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		
		<Setter Property="VerticalContentAlignment" Value="Center" />
		
		<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
		
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		
		<Setter Property="BorderThickness" Value="0" />
		
		<Setter Property="FontSize" Value="16" />
		
		<Setter Property="FontWeight" Value="SemiBold" />
		
		<Setter Property="CornerRadius" Value="18" />
	
	</Style>
	
	<!-- ============================= -->
	<!-- Button Hover -->
	<!-- ============================= -->

	<Style Selector="Button.NexusPrimaryButton:pointerover">

		<Setter Property="Background"
                Value="{DynamicResource PrimaryHoverBrush}" />

	</Style>

	<!-- ============================= -->
	<!-- Social Login Buttons -->
	<!-- ============================= -->

	<Style Selector="Button.NexusSocialButton">

		<Setter Property="Height" Value="52" />

		<Setter Property="HorizontalAlignment" Value="Stretch" />

		<Setter Property="HorizontalContentAlignment" Value="Center" />

		<Setter Property="VerticalContentAlignment" Value="Center" />

		<Setter Property="Background" Value="{DynamicResource InputBrush}" />

		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />

		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />

		<Setter Property="BorderThickness" Value="1" />

		<Setter Property="CornerRadius" Value="16" />

		<Setter Property="FontSize" Value="16" />

		<Setter Property="FontWeight" Value="SemiBold" />

		<Setter Property="Padding" Value="20,0" />

	</Style>


	<Style Selector="Button.SocialLoginButton:pointerover">

		<Setter Property="Background"
				Value="{DynamicResource CardBrush}" />

		<Setter Property="BorderBrush"
				Value="{DynamicResource PrimaryBrush}" />

	</Style>	


	<!-- ============================= -->
	<!-- Button Pressed -->
	<!-- ============================= -->

	<Style Selector="Button.NexusPrimaryButton:pressed">

		<Setter Property="Background"
                Value="{DynamicResource PrimaryPressedBrush}" />

	</Style>


	<!-- ============================= -->
	<!-- Auth Link -->
	<!-- ============================= -->

	<Style Selector="Button.NexusLinkButton">

		<Setter Property="Background" Value="Transparent" />

		<Setter Property="BorderThickness" Value="0" />

		<Setter Property="Foreground" Value="{DynamicResource PrimaryHoverBrush}" />

		<Setter Property="FontSize" Value="14" />

		<Setter Property="FontWeight" Value="SemiBold" />

		<Setter Property="Padding" Value="0" />

		<Setter Property="HorizontalContentAlignment" Value="Center" />

		<Setter Property="VerticalContentAlignment" Value="Center" />

	</Style>

	<!-- ============================= -->
	<!-- Auth Title -->
	<!-- ============================= -->

	<Style Selector="TextBlock.AuthTitleStyle">
		
		<Setter Property="FontSize" Value="30" />
		
		<Setter Property="FontWeight" Value="SemiBold" />
	
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		
		<Setter Property="HorizontalAlignment" Value="Center" />
	
	</Style>

	<!-- ============================= -->
	<!-- Auth Subtitle -->
	<!-- ============================= -->

	<Style Selector="TextBlock.AuthSubtitleStyle">
		
		<Setter Property="FontSize" Value="15" />
		
		<Setter Property="FontWeight" Value="Normal" />
		
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
		
		<Setter Property="HorizontalAlignment" Value="Center" />
	
	</Style>


	<!-- ============================= -->
	<!-- Auth Devider Style -->
	<!-- ============================= -->

	<Style Selector="TextBlock.AuthDividerTextStyle">

		<Setter Property="FontSize"
				Value="12" />

		<Setter Property="Foreground"
				Value="{DynamicResource SecondaryTextBrush}" />

		<Setter Property="FontWeight"
				Value="Normal" />

		<Setter Property="HorizontalAlignment"
				Value="Center" />

		<Setter Property="VerticalAlignment"
				Value="Center" />

	</Style>


	<!-- ============================= -->
	<!-- Chat List Item -->
	<!-- ============================= -->
	<Style Selector="Button.ChatListItemButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="CornerRadius" Value="16" />
		<Setter Property="Padding" Value="10" />
		<Setter Property="Margin" Value="0,2" />
	</Style>

	<Style Selector="Button.ChatListItemButton:pointerover">
		<Setter Property="Background" Value="{DynamicResource InputBrush}" />
	</Style>
	<Style Selector="Button.ChatListItemButton.selected">
		<Setter Property="Background" Value="{DynamicResource InputBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
	</Style>
	<!-- ============================= -->
	<!-- Chat Icon Buttons -->
	<!-- ============================= -->
	<Style Selector="Button.NexusIconButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="40" />
		<Setter Property="Height" Value="40" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.NexusIconButton:pointerover">
		<Setter Property="Background" Value="{DynamicResource InputBrush}" />
	</Style>
	<!-- ============================= -->
	<!-- Send Button -->
	<!-- ============================= -->
	<Style Selector="Button.NexusSendButton">
		<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Width" Value="44" />
		<Setter Property="Height" Value="44" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="CornerRadius" Value="100" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>
	<Style Selector="Button.NexusSendButton:pointerover">
		<Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
	</Style>
	<!-- ============================= -->
	<!-- Chat Input -->
	<!-- ============================= -->
	<Style Selector="TextBox.NexusChatInput">
		<Setter Property="Height" Value="50" />
		<Setter Property="Padding" Value="18,0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Background" Value="{DynamicResource InputBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="WatermarkForeground" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="CornerRadius" Value="100" />
	</Style>
	<!-- ============================= -->
	<!-- Sidebar Search Input -->
	<!-- ============================= -->
	<Style Selector="TextBox.NexusSearchInput">
		<Setter Property="Height" Value="44" />
		<Setter Property="Padding" Value="16,0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Background" Value="{DynamicResource InputBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="WatermarkForeground" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="CornerRadius" Value="14" />
	</Style>
	<!-- ============================= -->
	<!-- Dev Nav Bar -->
	<!-- ============================= -->
	<Style Selector="Button.DevNavButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="CornerRadius" Value="100" />
	</Style>
	<Style Selector="Button.DevNavButton.active">
		<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="Foreground" Value="White" />
	</Style>	
	
</Styles>